{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/icons/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "dragonball-api",
      "urls": [
        "https://dragonball-api.com/api/**"
      ],
      "version": 1,
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 300,
        "maxAge": "7d",
        "timeout": "5s",
        "cacheOpaqueResponses": false
      },
      "cacheQueryOptions": {
        "ignoreSearch": false
      }
    },
    {
      "name": "dragonball-images",
      "urls": [
        "https://dragonball-api.com/characters/**",
        "https://dragonball-api.com/planetas/**",
        "https://dragonball-api.com/transformaciones/**"
      ],
      "version": 1,
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 300,
        "maxAge": "30d",
        "timeout": "3s",
        "cacheOpaqueResponses": true
      }
    }
  ]
}